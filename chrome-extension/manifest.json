{
  "manifest_version": 3,
  "name": "Codex ChatGPT Web Backend",
  "version": "0.1.0",
  "description": "Routes explicitly bound Codex tasks through dedicated ChatGPT tabs in this Chrome profile.",
  "key": "",
  "permissions": ["nativeMessaging", "storage"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
